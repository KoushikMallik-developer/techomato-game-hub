# Copy this file to .env (local dev) and fill in ONE of the TURN options below.
# On Vercel, add the same names under Project Settings > Environment Variables, then redeploy.

# Option A (recommended): Metered credentials URL. Server-only (no VITE_ prefix), so the key stays private:
# served to the browser through api/turn.js on Vercel and a dev middleware in vite.config.js.
METERED_TURN_URL=

# Option B: a static TURN server (e.g. your own coturn)
# VITE_TURN_URLS=turn:your-host:3478,turns:your-host:443?transport=tcp
# VITE_TURN_USERNAME=
# VITE_TURN_CREDENTIAL=

# Optional: your own PeerJS signalling server
# VITE_SIGNAL_URL=wss://your-host:9000/peerjs?key=peerjs

# ── Accounts (Firebase, free Spark plan) ──
# Firebase Console > Project settings > Your apps > Web app > SDK setup. These are public identifiers, not secrets;
# access is enforced by firestore.rules. Leave them empty to run without accounts.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
